# ---------------------------------------------------------------------------
# Buildora API - local development environment
# Copy this file to `.env` and replace the placeholder values.
# Never commit a real `.env` file.
# ---------------------------------------------------------------------------

# Locally this is development. On Vercel set it to production (or let Vercel
# set it). npm treats NODE_ENV=production as "omit devDependencies", so the
# repository `.npmrc` sets `include=dev` to keep the build toolchain installed.
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
BODY_LIMIT=1mb

# --- Neon PostgreSQL -------------------------------------------------------
# DATABASE_URL is used by the API and MUST point at Neon's pooled endpoint.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/buildora?sslmode=require"
# DIRECT_URL is used only by Prisma Migrate and MUST point at the direct endpoint.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/buildora?sslmode=require"
# Keep this low on Vercel (1 per function instance is usually enough).
DATABASE_POOL_MAX=10

# --- HTTP ------------------------------------------------------------------
# Comma-separated browser origins. Empty means same-origin only in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Swagger is enabled by default outside production and disabled in production.
# Uncomment only if you intentionally want it in production.
# SWAGGER_ENABLED=true

# --- Rate limiting ---------------------------------------------------------
# Fixed window applied per client address and per route.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
